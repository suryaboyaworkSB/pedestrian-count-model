{
  "video": {
    "input_path": "data/input.mp4",
    "output_path": "outputs/annotated_output.mp4",
    "target_fps": 8,
    "frame_skip": 3
  },
  "detection": {
    "model": "yolov8n.pt",
    "confidence_threshold": 0.4,
    "iou_threshold": 0.45,
    "device": "cpu"
  },
  "tracking": {
    "max_age": 30,
    "min_hits": 3,
    "iou_threshold": 0.3
  },
  "roi": {
    "enabled": false,
    "coordinates": [],
    "counting_line": []
  },
  "output": {
    "csv_path": "outputs/hourly_counts.csv",
    "json_path": "outputs/hourly_counts.json",
    "save_annotated_video": true
  },
  "lighting": {
    "apply_clahe": true,
    "clahe_clip_limit": 2.0,
    "clahe_tile_grid_size": [8, 8]
  }
}
